# Common
FNAME_BASE=mylogfile
RECORD_QUEUE_SIZE=50

# LOGLEVEL: DEBUG, NORM
LOGLEVEL=NORM

# Upload endpoint (shared)
# - HttpPostUploader: UPLOAD_TARGET_URL + UPLOAD_KEY
# - JsonHttpUploader: UPLOAD_TARGET_URL (Telegraf http_listener_v2 endpoint)
UPLOAD_QUEUE_SIZE=50
UPLOAD_TARGET_URL=https://example.com/upload.php
# Example for JsonHttpUploader:
# UPLOAD_TARGET_URL=http://192.168.1.100:8080/smartmeter
UPLOAD_KEY=xxxxxxxxxxxxxxxx

# Wi-SUN / B-route
BROUTE_PORT=/dev/serial/by-id/usb-FTDI_FT230X_Basic_UART_xxxxxxxx-if00-port0
BROUTE_BAUDRATE=115200
WISUN_TYPE=IPS
BROUTE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BROUTE_PASSWORD=xxxxxxxxxxxx
BROUTE_RECORD_RAW_EPC=true
# JSON format: [{"epc":["D3","D7","E1"],"cycle":3600},...]
BROUTE_REQUESTS=[{"epc":["D3","D7","E1"],"cycle":3600},{"epc":["E7"],"cycle":10},{"epc":["E0"],"cycle":300}]

# SerialReader (keiconf_serial.py)
SERIAL_PORT=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_YYYYYYYY-if00-port0
SERIAL_BAUDRATE=115200
